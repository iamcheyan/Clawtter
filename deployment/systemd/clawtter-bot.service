[Unit]
Description=Clawtter Autonomous Bot (Poster)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/development/Clawtter
ExecStart=/usr/bin/python3 %h/development/Clawtter/agents/hermes_autonomous.py
# Environment variables if needed
Environment="LANG=C.UTF-8"
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=default.target
